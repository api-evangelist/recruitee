       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "properties": {
           "status": {
            "type": "string",
            "default": "completed",
            "enum": [
             "sent",
             "completed",
             "failed",
             "canceled"
            ]
           },
           "score": {
            "type": "string",
            "description": "Examples: `\"10\"`, `\"10%\"`, `\"10/20\"`. Strings with more than 5 characters will not be shown in the badge.",
            "default": "50%"
           },
           "completed_at": {
            "type": "string",
            "default": "2021-02-24T14:00:00Z",
            "format": "date"
           },
           "subtitle": {
            "type": "string",
            "default": "TypeScript"
           },
           "properties": {
            "type": "array",
            "items": {
             "properties": {
              "key": {
               "type": "string"
              },
              "value": {
               "type": "string"
              }
             },
             "required": [
              "key",
              "value"
             ],
             "type": "object"
            }
           },
           "urls": {
            "type": "object",
            "properties": {
             "open": {
              "type": "string"
             },
             "download_pdf": {
              "type": "string"
             },
             "cancel_invitation": {
              "type": "string"
             }
            }
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n  \"report\": {\n    \"candidate_id\": 1,\n    \"company_id\": 1,\n    \"completed_at\": \"2021-02-24T14:00:00Z\",\n    \"id\": \"ff96b40f-8f11-4155-b059-e3d25e149bfa\",\n    \"properties\": [\n      {\n        \"key\": \"Distinguishing feature\",\n        \"value\": \"Strong culture fit\"\n      },\n      {\n        \"key\": \"Agility\",\n        \"value\": \"10\"\n      }\n    ],\n    \"score\": \"50%\",\n    \"sent_at\": \"2021-02-25T10:58:29Z\",\n    \"sent_by_admin\": {\n      \"first_name\": \"Richard\",\n      \"id\": 1,\n      \"last_name\": \"Stark\"\n    },\n    \"sent_by_admin_id\": 1,\n    \"status\": \"completed\",\n    \"subtitle\": \"TypeScript\",\n    \"test_id\": \"1\",\n    \"test_name\": \"JavaScript\",\n    \"urls\": {\n      \"open\": null\n    }\n  }\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "report": {
             "type": "object",
             "properties": {
              "candidate_id": {
               "type": "integer",
               "example": 1,
               "default": 0
              },
              "company_id": {
               "type": "integer",
               "example": 1,
               "default": 0
              },
              "completed_at": {
               "type": "string",
               "example": "2021-02-24T14:00:00Z"
              },
              "id": {
               "type": "string",
               "example": "ff96b40f-8f11-4155-b059-e3d25e149bfa"
              },
              "properties": {
               "type": "array",
               "items": {
                "type": "object",
                "properties": {
                 "key": {
                  "type": "string",
                  "example": "Distinguishing feature"
                 },
                 "value": {
                  "type": "string",
                  "example": "Strong culture fit"
                 }
                }
               }
              },
              "score": {
               "type": "string",
               "example": "50%"
              },
              "sent_at": {
               "type": "string",
               "example": "2021-02-25T10:58:29Z"
              },
              "sent_by_admin": {
               "type": "object",
               "properties": {
                "first_name": {
                 "type": "string",
                 "example": "Richard"
                },
                "id": {
                 "type": "integer",
                 "example": 1,
                 "default": 0
                },
                "last_name": {
                 "type": "string",
                 "example": "Stark"
                }
               }
              },
              "sent_by_admin_id": {
               "type": "integer",
               "example": 1,
               "default": 0
              },
              "status": {
               "type": "string",
               "example": "completed"
              },
              "subtitle": {
               "type": "string",
               "example": "TypeScript"
              },
              "test_id": {
               "type": "string",
               "example": "1"
              },
              "test_name": {
               "type": "string",
               "example": "JavaScript"
              },
              "urls": {
               "type": "object",
               "properties": {
                "open": {}
               }
              }
             }
            }
           }
          }
         }
        }
       }
      },
      "deprecated": false
     }
    }
