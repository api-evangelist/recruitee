                "first_name",
                "last_name",
                "email",
                "phone",
                "admin",
                "offer"
               ]
              },
              "name": {
               "type": "string",
               "description": "Not accepted for `admin` and `offer` input kinds, otherwise required."
              },
              "required": {
               "type": "boolean",
               "default": true
              }
             },
             "required": [
              "kind",
              "required"
             ],
             "type": "object"
            }
           }
          }
         }
        }
